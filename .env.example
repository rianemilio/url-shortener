APP_MONGO_URI=mongodb://localhost:27017
APP_MONGO_DB_NAME=url_shortener
APP_MONGO_TIMEOUT_MS=2000
APP_REDIS_URI=redis://localhost:6379/0
APP_REDIS_CACHE_TTL_SECONDS=3600
APP_REDIS_TIMEOUT_SECONDS=0.5
APP_RABBITMQ_URI=amqp://guest:guest@localhost:5672/
APP_RABBITMQ_TIMEOUT_SECONDS=2.0
APP_RABBITMQ_RECONNECT_INTERVAL_SECONDS=5.0
APP_RATE_LIMIT_CREATE_REQUESTS=20
APP_RATE_LIMIT_CREATE_WINDOW_SECONDS=60
APP_BASE_URL=http://localhost:8000
APP_LOG_LEVEL=INFO
